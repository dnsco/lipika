#!/usr/bin/env python3
"""
lipika — one entry point for every tool, callable by name.

WHY THIS EXISTS
  A definition is a system prompt, so any path written into one has to be correct on every machine
  that loads it. The old answer was a placeholder substituted when the files were copied into a
  vault, which is the mechanism this project is retiring.

  Measured 2026-08-20, by probing a subagent spawned from an installed plugin:

    CLAUDE_PLUGIN_ROOT   empty   -- documented for component files, NOT populated in a subagent's
                                    shell, so `${CLAUDE_PLUGIN_ROOT}/tools/x.py` would fail at the
                                    first call, in the role least able to explain why
    <plugin>/bin on PATH  yes    -- three installed plugins, same shape

  So the tools are reached by NAME. `lipika budget-check <path>` needs no path, no environment
  variable and no config entry to locate itself, which is the property a definition needs. Where
  the *vault* is remains a separate question, answered by vault_config for every subcommand.

  Outside a plugin install, put this directory on PATH, or call it by path -- it is a plain script.
"""

import os
import sys
from pathlib import Path

TOOLS = Path(__file__).resolve().parent.parent / "tools"


def commands():
    """Every tool, as a subcommand name. budget_check.py -> budget-check."""
    out = {}
    for p in sorted(TOOLS.glob("*.py")):
        if p.name.startswith("_"):
            continue
        out[p.stem.replace("_", "-")] = p
    return out


def first_line_of(path):
    """The tool's own one-line summary, from its docstring. Never a hand-written duplicate --
    a second copy of a description is a second thing to keep true."""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return ""
    for marker in ('"""', "'''"):
        if marker in text:
            body = text.split(marker, 2)
            if len(body) > 2:
                for line in body[1].strip().splitlines():
                    if line.strip():
                        return line.strip()
    return ""


def usage(cmds, out=sys.stdout):
    print("usage: lipika <command> [args...]\n", file=out)
    print("  vault-config path            where the vault is, for `cd $(lipika vault-config path)`",
          file=out)
    print("  vault-config show            that, plus the budgets and frozen tiers in force\n", file=out)
    width = max(len(c) for c in cmds)
    for name, path in cmds.items():
        summary = first_line_of(path)
        print(f"  {name:<{width}}  {summary[:96 - width]}", file=out)
    print("\nEvery command resolves the vault the same way: --vault, then $LIPIKA_VAULT, then\n"
          "~/.config/lipika/config.json, then the checkout you are standing in. A command that\n"
          "cannot resolve one refuses rather than guessing.", file=out)


def main(argv):
    cmds = commands()
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage(cmds)
        return 0
    name = argv[0]
    target = cmds.get(name) or cmds.get(name.replace("-", "_"))
    if not target:
        print(f"lipika: no such command '{name}'\n", file=sys.stderr)
        usage(cmds, out=sys.stderr)
        return 2
    cmd = [sys.executable, str(target), *argv[1:]]
    # Telemetry off: exec, as before. On: run as a child to time it, and return its exit code
    # unchanged (a signal as 128+N). evals/perf/test_dispatcher.py checks the passthrough.
    if os.environ.get("LIPIKA_TELEMETRY", "1") == "0":
        os.execv(sys.executable, cmd)
    import signal
    import subprocess
    import time
    signal.signal(signal.SIGINT, signal.SIG_IGN)   # the child handles ^C
    t = time.perf_counter()
    rc = subprocess.call(cmd)
    ms = (time.perf_counter() - t) * 1000
    code = 128 - rc if rc < 0 else rc
    try:
        sys.path.insert(0, str(TOOLS))
        import _telemetry
        _telemetry.record(target.stem.replace("_", "-"), argv[1:], ms, code)
    except Exception:
        pass
    return code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
